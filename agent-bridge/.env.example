# Agent Bridge — תבנית הגדרות. אין למלא כאן ערכים אמיתיים.
# העתיקו לקובץ .env מקומי (שנמצא ב-.gitignore) ומלאו שם.

# מצב ה-GitHub adapter: dry_run (ברירת מחדל) או live.
# ב-MVP הזה מצב live חסום בקוד ודורש מימוש ואישור מפורש.
GITHUB_MODE=dry_run

# טוקן GitHub. נשאר ריק ב-MVP — אין קריאות רשת.
GITHUB_TOKEN=

# מזהה הגורם המאשר, לצורכי audit log.
AGENT_BRIDGE_APPROVER=local-operator

# מימוש ה-runner. ב-MVP קיים רק mock.
AGENT_BRIDGE_RUNNER=mock

# תיקיית הנתונים המקומית (משימות ו-audit).
AGENT_BRIDGE_DATA_DIR=.agent-bridge-data
